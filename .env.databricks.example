# Copy to .env.databricks (git-ignored) and fill in. Sign in first with:
#   databricks auth login --host <workspace URL>   (profile name below)
DATABRICKS_CONFIG_PROFILE=ecom
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<SQL warehouse id>
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<SQL warehouse id>
DATABRICKS_CATALOG=ecom
